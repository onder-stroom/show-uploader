{
  "name": "@show-uploader/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @show-uploader/domain build && tsc",
    "dev": "pnpm --filter @show-uploader/domain build && tsx watch --env-file ../.env src/index.ts",
    "test": "pnpm --filter @show-uploader/domain build && vitest run",
    "typegen": "pnpm dlx pocketbase-typegen --url \"${POCKETBASE_URL:-https://agenda.coming-soon.space}\" --email \"$PB_SERVICE_EMAIL\" --password \"$PB_SERVICE_PASSWORD\" --out src/pocketbase-types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@show-uploader/domain": "workspace:*",
    "@trpc/server": "^11.18.0",
    "bullmq": "^5.80.10",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "groq-sdk": "^0.5.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "pocketbase": "^0.27.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
