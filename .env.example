# Worker → api write-back (published links land on the PocketBase archive record
# via the api's superuser). Defaults to the in-network service address in compose.
INTERNAL_API_URL=http://api:3000/api

# Postgres — the `postgres` service in the compose stack.
# The credentials below create that database on first start; DATABASE_URI is how
# the api and worker reach it. No sslmode: it is only reachable on the stack's
# internal network. A managed host instead (Neon, RDS) needs `?sslmode=require`.
POSTGRES_USER=show_uploader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=show_uploader
DATABASE_URI=postgresql://show_uploader:change-me@postgres:5432/show_uploader

# Minio (S3-compatible, runs in Docker)
S3_ACCESS_KEY=your-minio-root-user
S3_SECRET_KEY=your-minio-root-password   # min 8 chars
S3_BUCKET=show-uploader
# Browser-reachable Minio host for presigned upload URLs (internal is minio:9000).
# Set to your public Minio URL in production, e.g. https://minio.your-domain.com
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# S3_ENDPOINT is set automatically to http://minio:9000 inside Docker
# For external access (watcher script on Windows), use your server's public URL:
# S3_ENDPOINT=https://minio.your-domain.com

# Redis (set automatically in Docker Compose)
REDIS_URL=redis://localhost:6379

# Groq AI — generates the description/tag suggestions.
# Get a key: https://console.groq.com/keys  ->  "Create API Key" (free tier).
GROQ_API_KEY=your-groq-api-key

# ── YouTube OAuth2 ──────────────────────────────────────────────────────────
# Uploads land on the channel of whichever Google account authorises below.
# 1. https://console.cloud.google.com  ->  create (or pick) a project.
# 2. "APIs & Services" -> "Library" -> enable "YouTube Data API v3".
# 3. "OAuth consent screen": User type External, fill the app name, and under
#    "Test users" add the Google account that owns the target channel. Add the
#    scope  https://www.googleapis.com/auth/youtube.upload
# 4. "Credentials" -> "Create credentials" -> "OAuth client ID" -> type
#    "Desktop app". Copy the Client ID + Client secret below.
# 5. Get a REFRESH token (one-time): https://developers.google.com/oauthplayground
#    - gear icon (top right) -> tick "Use your own OAuth credentials" -> paste
#      the Client ID + secret from step 4.
#    - left panel, in "Input your own scopes" enter:
#        https://www.googleapis.com/auth/youtube.upload
#      -> "Authorize APIs" -> sign in with the channel's account.
#    - "Exchange authorization code for tokens" -> copy the "Refresh token".
#    (Refresh tokens are long-lived; the worker mints access tokens from it.)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# ── MixCloud ────────────────────────────────────────────────────────────────
# Casts upload to the account that authorises. The token does not expire.
# 1. https://www.mixcloud.com/developers/create/  ->  create an app (any name;
#    set a Redirect URI you control, e.g. https://uploader.coming-soon.space/ ).
#    Copy the Client ID, Client Secret, and your Redirect URI.
# 2. In a browser, visit (fill in CLIENT_ID + REDIRECT_URI, url-encoded):
#      https://www.mixcloud.com/oauth/authorize?client_id=CLIENT_ID&redirect_uri=REDIRECT_URI
#    Approve — you're redirected to REDIRECT_URI?code=THE_CODE
# 3. Exchange the code for the token (fill all four values):
#      https://www.mixcloud.com/oauth/access_token?client_id=CLIENT_ID&redirect_uri=REDIRECT_URI&client_secret=CLIENT_SECRET&code=THE_CODE
#    The JSON response's "access_token" is the value below.
MIXCLOUD_ACCESS_TOKEN=your-access-token

# Archive quality (ffmpeg bitrate strings)
ARCHIVE_VIDEO_BITRATE=4000k
ARCHIVE_AUDIO_BITRATE=256k

# Auto edge-trim silence threshold (dB). Audio below this counts as silence, so
# a higher (less negative) value also trims quiet hiss/room tone. -30 catches
# typical hiss; go toward -40 to be gentler on quiet fade-ins. Edges only.
SILENCE_NOISE_DB=-30

# Jingle S3 key (optional — leave empty to disable)
# Upload your jingle file to minio/show-uploader/jingles/intro.m4a first
JINGLE_S3_KEY=jingles/intro.m4a

# Shared internal secret: authenticates the Windows drop-folder watcher AND the
# worker's write-back call to the api. Generate any long random string, e.g.
#   openssl rand -hex 32
WATCHER_API_KEY=generate-a-random-secret-here

# ── Zitadel (OIDC login) ────────────────────────────────────────────────────
# In your Zitadel console: create a project + a "User Agent (PKCE)" application.
#   ZITADEL_DOMAIN     = the instance domain, no https:// / trailing slash
#                        (Console URL host, e.g. your-org.eu1.zitadel.cloud)
#   ZITADEL_CLIENT_ID  = the application's Client ID
# Add the app redirect URI https://<your-uploader-host>/callback, and grant the
# `member` project role to each user who should have access.
ZITADEL_DOMAIN=your-org.eu1.zitadel.cloud
ZITADEL_CLIENT_ID=your-client-id

# ── PocketBase (agenda: schedule + archive records) ─────────────────────────
# POCKETBASE_URL is the public base of your PocketBase/agenda instance. The
# live-guard reads the episodes collection unauthenticated; the archive drafts
# and the write-back use the superuser below.
POCKETBASE_URL=https://agenda.coming-soon.space
# Buffer minutes applied before start / after end of a live show
LIVE_GUARD_BUFFER_MIN=15
# An episode claiming a longer air window than this is treated as bad schedule
# data and ignored — one record left at status=live with a five-day endTime
# otherwise parks every upload behind it.
LIVE_GUARD_MAX_EPISODE_HOURS=12
# Hard ceiling on how far a live show may defer queued work.
LIVE_GUARD_MAX_DEFER_MIN=240
# PocketBase SUPERUSER credentials — read at RUNTIME by the api to list draft
# archive records and write published links back onto them (and by
# `pnpm run typegen`). Create/find one under PocketBase admin -> Settings ->
# "Superusers". Keep secret; never commit the real values.
PB_SERVICE_EMAIL=your-pb-superuser@example.com
PB_SERVICE_PASSWORD=your-pb-superuser-password

# App
PORT=3000
NODE_ENV=production

# YouTube video visibility: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=unlisted

# Publish dry-run: auto (simulate only when creds are placeholders) | true | false
PUBLISH_DRY_RUN=auto

# Public base URL of the uploader itself. Used to build the permanent recording
# links stored on the PocketBase agenda records (/api/public/recordings/...).
# Those links are opened by browsers, so this must be the externally reachable
# host, not a docker alias. Leave unset to skip attaching them.
APP_PUBLIC_URL=https://uploader.example.com
