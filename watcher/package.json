{
  "name": "@show-uploader/watcher",
  "version": "2.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @show-uploader/domain build && tsc",
    "dev": "pnpm --filter @show-uploader/domain build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter @show-uploader/domain build && vitest run",
    "bundle": "pnpm --filter @show-uploader/domain build && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/recordings-service.js"
  },
  "dependencies": {
    "@show-uploader/domain": "workspace:*",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
